{
  // The Convex regime — bundled by Convex, not emitted by tsc, so it does not
  // extend tsconfig.base.json and does not join the composite build. Checked by
  // `pnpm typecheck:convex`. See AGENTS.md for the three regimes.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
