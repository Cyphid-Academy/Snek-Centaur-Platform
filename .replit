modules = ["nodejs-20"]
[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Visual Tester"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SpacetimeDB"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Convex Dev"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @cyphid/centaur-server-reference dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Visual Tester"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:tester"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "SpacetimeDB"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:stdb"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Convex Dev"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev:convex"

[workflows.workflow.metadata]
outputType = "console"

# Destructive git workflows. Each refuses to run unless its own gitignored
# arming file exists, so a Run-button sweep cannot trigger them. The procedure
# is in AGENTS.md → "Scripted history rewriting".
[[workflows.workflow]]
name = "Scripted rebase"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-scripted-rebase.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Hard reset to origin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/hard-reset-to-origin.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000
