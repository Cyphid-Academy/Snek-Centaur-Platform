{
  "name": "@cyphid/snek-centaur-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "@fission-ai/openspec", "esbuild"],
    "packageExtensions": {
      "@convex-dev/better-auth": {
        "peerDependenciesMeta": {
          "react": {
            "optional": true
          }
        }
      }
    }
  },
  "scripts": {
    "build:packages": "tsc -b",
    "typecheck": "pnpm build:packages && pnpm typecheck:convex && pnpm typecheck:stdb-module && pnpm --filter @cyphid/centaur-server-reference typecheck && pnpm --filter @cyphid/visual-tester typecheck && pnpm --filter @cyphid/e2e typecheck",
    "typecheck:convex": "tsc -p packages/convex-snek-platform/tsconfig.convex.json && tsc -p packages/convex-centaur-state/tsconfig.convex.json && tsc -p packages/convex-host/convex/tsconfig.json",
    "typecheck:stdb-module": "tsc -p packages/stdb/spacetimedb/tsconfig.json && tsc -p apps/demo-game/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build:packages && vitest run && pnpm --filter @cyphid/visual-tester test && pnpm --filter @cyphid/centaur-server-reference test",
    "coverage": "vitest run --project '@cyphid/snek-engine' --coverage.enabled --coverage.provider=v8 --coverage.include='packages/engine/src/resolve/**' --coverage.reporter=text",
    "smoke": "pnpm build:packages && node scripts/smoke-app.mjs",
    "e2e": "pnpm build:packages && pnpm --filter @cyphid/e2e test",
    "e2e:browsers": "pnpm build:packages && pnpm --filter @cyphid/e2e test:browsers",
    "check:commit": "node scripts/check-commit.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "verify": "pnpm lint && pnpm check:public-surface && pnpm typecheck && pnpm test && pnpm smoke && pnpm spec:check",
    "demo": "pnpm build:packages && node scripts/demo-stack/run.mjs",
    "demo:seed": "node scripts/demo-stack/seed.mjs",
    "demo:codegen": "node scripts/generate-demo-bindings.mjs",
    "dev": "pnpm build:packages && pnpm --filter @cyphid/centaur-server-reference dev",
    "start": "pnpm --filter @cyphid/centaur-server-reference build && node apps/centaur-server-reference/build/index.js",
    "dev:tester": "pnpm build:packages && pnpm --filter @cyphid/visual-tester dev",
    "dev:convex": "pnpm --filter @cyphid/snek-convex-host exec convex dev",
    "dev:convex:local": "CONVEX_AGENT_MODE=anonymous pnpm --filter @cyphid/snek-convex-host exec convex dev",
    "setup:stdb": "bash scripts/install-spacetime.sh",
    "dev:stdb": "spacetime start --data-dir .stdb/data --listen-addr 127.0.0.1:3000 --non-interactive",
    "stdb:publish": "pnpm build:packages && spacetime publish --server local --yes -p packages/stdb/spacetimedb snek-local",
    "build": "pnpm -r build",
    "codegen": "pnpm --filter @cyphid/snek-convex-host codegen",
    "spec:validate": "openspec validate --specs --strict",
    "spec:validate:changes": "node scripts/validate-open-changes.mjs",
    "spec:citations": "node scripts/check-spec-citations.mjs",
    "spec:freshness": "node scripts/check-change-freshness.mjs",
    "spec:audit": "node scripts/audit-all-modules.mjs",
    "spec:fold": "node scripts/fold-change.mjs",
    "spec:graph": "node scripts/spec-graph.mjs",
    "spec:check": "pnpm spec:validate && pnpm spec:validate:changes && pnpm spec:citations && pnpm spec:freshness && pnpm spec:graph --check && pnpm spec:audit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@fission-ai/openspec": "^1.6.0",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "svelte-check": "^4.7.4",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
