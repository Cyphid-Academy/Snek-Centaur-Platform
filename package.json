{
  "name": "@cyphid/snek-centaur-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "@fission-ai/openspec", "esbuild"]
  },
  "scripts": {
    "build:packages": "tsc -b",
    "typecheck": "tsc -b && pnpm --filter @cyphid/centaur-server-reference typecheck && pnpm --filter @cyphid/visual-tester typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build:packages && vitest run && pnpm --filter @cyphid/visual-tester test",
    "coverage": "vitest run --project '@cyphid/snek-engine' --coverage.enabled --coverage.provider=v8 --coverage.include='packages/engine/src/resolve/**' --coverage.reporter=text",
    "smoke": "pnpm build:packages && node scripts/smoke-app.mjs",
    "check:commit": "node scripts/check-commit.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke && pnpm spec:check",
    "dev": "pnpm build:packages && pnpm --filter @cyphid/centaur-server-reference dev",
    "dev:tester": "pnpm build:packages && pnpm --filter @cyphid/visual-tester dev",
    "build": "pnpm -r build",
    "spec:validate": "openspec validate --specs --strict",
    "spec:validate:changes": "node scripts/validate-open-changes.mjs",
    "spec:citations": "node scripts/check-spec-citations.mjs",
    "spec:freshness": "node scripts/check-change-freshness.mjs",
    "spec:audit": "node scripts/audit-all-modules.mjs",
    "spec:fold": "node scripts/fold-change.mjs",
    "spec:graph": "node scripts/spec-graph.mjs",
    "spec:check": "pnpm spec:validate && pnpm spec:validate:changes && pnpm spec:citations && pnpm spec:freshness && pnpm spec:graph --check && pnpm spec:audit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@fission-ai/openspec": "^1.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
