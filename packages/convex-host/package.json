{
  "name": "@cyphid/snek-convex-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm typecheck:convex",
    "typecheck:convex": "tsc -p convex",
    "test": "vitest run",
    "codegen": "CONVEX_SELF_HOSTED_URL=http://127.0.0.1:6790 CONVEX_SELF_HOSTED_ADMIN_KEY=fake convex codegen --typecheck disable || true"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@cyphid/convex-centaur-state": "workspace:*",
    "@cyphid/convex-snek-platform": "workspace:*",
    "@cyphid/snek-engine": "workspace:*",
    "@cyphid/snek-game-configuration": "workspace:*",
    "@cyphid/snek-platform-auth": "workspace:*",
    "better-auth": "1.6.29",
    "convex": "^1.44.0",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cyphid/snek-stdb": "workspace:*",
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.55",
    "typescript": "*",
    "vitest": "*"
  }
}
