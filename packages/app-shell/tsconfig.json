{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // A browser library: `tsconfig.base.json` ships no DOM lib because the two
    // apps inherit it from their generated SvelteKit config, which this package
    // (deliberately not a SvelteKit app) has no equivalent of.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "*.config.ts", "svelte.config.js"],
  "exclude": ["node_modules", "dist"]
}
