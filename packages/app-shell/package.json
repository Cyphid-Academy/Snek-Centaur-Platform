    "test": "vitest run"
  },
  "dependencies": {
    "@cyphid/snek-engine": "workspace:*",
    "clipper2-ts": "2.0.1-18",
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "*",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.56.8"
  }
}
