{
  // The Convex half of this package: component config, schema, functions, and
  // Convex's generated files. Deliberately does NOT extend tsconfig.base.json —
  // the generated code is not written for `exactOptionalPropertyTypes`,
  // `noUncheckedIndexedAccess`, or `verbatimModuleSyntax`, and these files are
  // bundled by Convex rather than emitted by tsc, so they cannot join the
  // composite build. Checked by `pnpm typecheck:convex`.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["convex/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
