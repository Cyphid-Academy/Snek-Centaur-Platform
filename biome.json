{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "include": ["**/tsconfig.*.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ],
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "_generated",
      ".svelte-kit",
      "build",
      "*.tsbuildinfo",
      ".git",
      ".local",
      ".convex",
      ".stdb",
      ".agents",
      ".cache",
      ".upm",
      ".config",
      "attached_assets",
      "test-results",
      "playwright-report",
      "spec",
      "informal-spec",
      "**/*.svelte"
    ]
  }
}
